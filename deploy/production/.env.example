# Copy to .env on the server and set mode 600. Do not commit the real file.
POSTGRES_PASSWORD=replace-with-a-random-password
CLICKHOUSE_PASSWORD=replace-with-a-random-password
AEROLOG_JWT_SECRET=replace-with-a-random-64-character-secret
AEROLOG_BOOTSTRAP_ADMIN_EMAILS=admin@example.com,admin2@example.com
AEROLOG_BOOTSTRAP_ADMIN_PASSWORD=replace-with-your-initial-admin-password
# Public deployment values. Use values owned by your organization.
AEROLOG_PUBLIC_HOST=analytics.example.com
# Public IP or DNS name advertised only to the approved Sensors Data server.
# The real value belongs in the server-only .env file.
AEROLOG_KAFKA_EXTERNAL_ADVERTISED_ADDR=kafka.example.com
# Optional. Bind the Kafka receiver to an intranet address instead of every
# host interface when the Sensors Data cluster shares the same private network.
AEROLOG_KAFKA_BIND_ADDR=0.0.0.0
GRAFANA_ADMIN_USER=admin@example.com
