# 复制到服务器 .env 并设置权限为 600；真实文件不可提交。
POSTGRES_PASSWORD=replace-with-a-random-password
CLICKHOUSE_PASSWORD=replace-with-a-random-password
AEROLOG_JWT_SECRET=replace-with-a-random-64-character-secret
# 用于加密 PostgreSQL 内存储的第三方接入凭据。使用独立随机密钥；修改后旧 API Key 将无法读取。
AEROLOG_INTEGRATION_ENCRYPTION_KEY=replace-with-a-random-64-character-secret
AEROLOG_BOOTSTRAP_ADMIN_EMAILS=admin@example.com,admin2@example.com
AEROLOG_BOOTSTRAP_ADMIN_PASSWORD=replace-with-your-initial-admin-password
# 可选企业微信群机器人 Webhook；真实 URL 仅保留在 .env。
AEROLOG_WECOM_WEBHOOK_URL=
# 企业微信 AI 机器人。内部 Token 仅供机器人容器与 API 容器通信，需使用独立随机值。
AEROLOG_WECOM_BOT_ID=
AEROLOG_WECOM_BOT_SECRET=
AEROLOG_WECOM_BOT_INTERNAL_TOKEN=replace-with-a-random-64-character-secret
# 企业微信 AI 机器人 Prometheus 指标端口，仅 Docker 内网监听。
AEROLOG_WECOM_BOT_METRICS_PORT=9106
AEROLOG_HOST_INSPECTOR_TOKEN=replace-with-a-different-random-64-character-secret
AEROLOG_AI_BASE_URL=https://api.openai.com
AEROLOG_AI_API_KEY=
AEROLOG_AI_MODEL=
# 公网部署配置，必须使用组织自有的值。
AEROLOG_PUBLIC_HOST=analytics.example.com
# 仅向已授权神策服务器声明的公网 IP 或 DNS；真实值仅保留在服务器 .env。
AEROLOG_KAFKA_EXTERNAL_ADVERTISED_ADDR=kafka.example.com
# 可选：神策集群共享私网时，将 Kafka 接收端绑定到内网地址，而非所有主机网卡。
AEROLOG_KAFKA_BIND_ADDR=0.0.0.0
# 可选外部 Kafka 覆盖。保留 redpanda:9092 使用内置 Redpanda；也可设置私有托管 Kafka 地址，如 10.0.0.10:9092。
AEROLOG_KAFKA_BROKERS=redpanda:9092
# AeroLog SDK 接入与外部数据源 Topic 必须隔离。
AEROLOG_KAFKA_TOPIC=events.raw
AEROLOG_GROUP_ID=aerolog-consumer
# 共享神策订阅应用。项目在“项目管理 → 神策接入”完成连接后，按源神策 project_id 路由。
AEROLOG_SENSORS_APPLICATION_NAME=aerolog-sensors-v1
# 仅兼容旧配置。所有活跃神策数据源完成映射后设为 0，避免未知来源进入无关项目。
AEROLOG_SENSORS_TARGET_PROJECT_ID=0
# 可选神策 FLATTEN_JSON 导入。配置共享应用和 Topic 后，以 sensorsdata profile 启动两个消费者。
AEROLOG_SENSORS_EVENTS_TOPIC=sensors.events.v1
AEROLOG_SENSORS_GROUP_ID=aerolog-sensors-consumer
AEROLOG_SENSORS_PROFILES_TOPIC=sensors.profiles.v1
AEROLOG_SENSORS_PROFILES_GROUP_ID=aerolog-sensors-profiles-consumer
# 两个消费者均使用有界同步 ClickHouse 写入。写入失败保留 Kafka offset 并按指数退避重试。
AEROLOG_CONSUMER_BATCH_SIZE=200
AEROLOG_CONSUMER_BATCH_MS=5000
AEROLOG_CONSUMER_WRITE_TIMEOUT_MS=15000
AEROLOG_CONSUMER_RETRY_INITIAL_MS=1000
AEROLOG_CONSUMER_RETRY_MAX_MS=30000
GRAFANA_ADMIN_USER=admin@example.com
