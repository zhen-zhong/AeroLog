# Copy to .env on the server and set mode 600. Do not commit the real file.
POSTGRES_PASSWORD=replace-with-a-random-password
CLICKHOUSE_PASSWORD=replace-with-a-random-password
AEROLOG_JWT_SECRET=replace-with-a-random-64-character-secret
# Encrypts third-party integration credentials stored in PostgreSQL. Generate a
# separate random secret; changing it makes previously saved API Keys unreadable.
AEROLOG_INTEGRATION_ENCRYPTION_KEY=replace-with-a-random-64-character-secret
AEROLOG_BOOTSTRAP_ADMIN_EMAILS=admin@example.com,admin2@example.com
AEROLOG_BOOTSTRAP_ADMIN_PASSWORD=replace-with-your-initial-admin-password
# Public deployment values. Use values owned by your organization.
AEROLOG_PUBLIC_HOST=analytics.example.com
# Public IP or DNS name advertised only to the approved Sensors Data server.
# The real value belongs in the server-only .env file.
AEROLOG_KAFKA_EXTERNAL_ADVERTISED_ADDR=kafka.example.com
# Optional. Bind the Kafka receiver to an intranet address instead of every
# host interface when the Sensors Data cluster shares the same private network.
AEROLOG_KAFKA_BIND_ADDR=0.0.0.0
# Optional external Kafka override. Leave as redpanda:9092 to use bundled
# Redpanda, or set a private managed Kafka address such as 10.0.0.10:9092.
AEROLOG_KAFKA_BROKERS=redpanda:9092
# Keep AeroLog SDK ingestion separate from any external data-source topic.
AEROLOG_KAFKA_TOPIC=events.raw
AEROLOG_GROUP_ID=aerolog-consumer
# Shared Sensors Data subscription application. Projects are routed by source
# Sensors Data project_id after being connected in 项目管理 → 神策接入.
AEROLOG_SENSORS_APPLICATION_NAME=aerolog-sensors-v1
# Legacy fallback only. Set 0 after every active Sensors Data source has a
# mapping, so an unknown source can never enter an unrelated project.
AEROLOG_SENSORS_TARGET_PROJECT_ID=0
# Optional Sensors Data FLATTEN_JSON import. Start both consumers with the
# sensorsdata profile after configuring the shared application and topics.
AEROLOG_SENSORS_EVENTS_TOPIC=sensors.events.v1
AEROLOG_SENSORS_GROUP_ID=aerolog-sensors-consumer
AEROLOG_SENSORS_PROFILES_TOPIC=sensors.profiles.v1
AEROLOG_SENSORS_PROFILES_GROUP_ID=aerolog-sensors-profiles-consumer
# Bounded synchronous ClickHouse writes for both consumers. Failed writes
# retain Kafka offsets and retry with exponential backoff.
AEROLOG_CONSUMER_BATCH_SIZE=200
AEROLOG_CONSUMER_BATCH_MS=5000
AEROLOG_CONSUMER_WRITE_TIMEOUT_MS=15000
AEROLOG_CONSUMER_RETRY_INITIAL_MS=1000
AEROLOG_CONSUMER_RETRY_MAX_MS=30000
GRAFANA_ADMIN_USER=admin@example.com
